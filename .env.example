# Mode Demo Cepat (true untuk pengujian demo lokal/offline, false untuk Supabase produksi)
VITE_DEMO_MODE=true

# Kredensial Supabase Client (Publik - Aman diakses klien browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CATATAN RAHASIA SERVER (TIDAK BOLEH BERAWALAN VITE_):
# COORDINATE_SHIFT_SECRET disimpan di Supabase Database Secrets / Vault / SQL Environment (bukan di frontend).
